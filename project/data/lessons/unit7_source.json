    {"context":"Hung: It is. What programme do you often watch, Phong?","translation":"Hùng: Đúng vậy. Phong thường xem chương trình nào?","answer":"Films","source_status":"user-provided-reference"},
    {"context":"Phong: Films. I like animated films like The Lion King.","translation":"Phong: Phim. Mình thích phim hoạt hình như Vua Sư Tử.","answer":"animated films","source_status":"user-provided-reference"},
    {"context":"Hung: I love them, too. They're wonderful.","translation":"Hùng: Mình cũng thích chúng. Chúng thật tuyệt vời.","answer":"wonderful","source_status":"user-provided-reference"},
    {"context":"Phong: I often watch them with my little brother, but he prefers cartoons.","translation":"Phong: Mình thường xem cùng em trai, nhưng em ấy thích phim hoạt họa hơn.","answer":"cartoons","source_status":"user-provided-reference"},
    {"context":"Hung: Tom and Jerry?","translation":"Hùng: Tom và Jerry phải không?","answer":"Tom and Jerry","source_status":"user-provided-reference"},
